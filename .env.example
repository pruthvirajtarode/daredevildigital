# Copy to .env.local for local dev. On Vercel, add these under
# Project → Settings → Environment Variables, then REDEPLOY.

# --- Meta Pixel (browser) — public, baked into the build ---
VITE_META_PIXEL_ID=

# --- Meta Conversions API (server) — keep the token SECRET ---
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional: from Events Manager → Test events (remove after testing)
META_TEST_EVENT_CODE=
# Optional: override Graph API version (default v25.0)
META_GRAPH_API_VERSION=

# --- Existing ---
WIX_CONTACT_WEBHOOK_URL=
